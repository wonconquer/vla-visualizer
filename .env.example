# Repository-relative paths, or operator-configured persistent storage
VLA_MODEL_CACHE=.cache/huggingface/hub
VLA_ARTIFACT_DIR=outputs/jobs
VLA_LIBERO_ASSETS=.cache/libero/assets
VLA_LIBERO_CONFIG=.cache/libero/config
VLA_SAMPLE=assets/sample_inputs/so100_observation.json
VLA_TRAINING_DATA=assets/training/so100_episode0.parquet
# VLA_WORKER_PYTHON=.venv/bin/python
# VLA_SIM_PYTHON=.venv-sim/bin/python
VLA_HOST=127.0.0.1
VLA_PORT=7860
VLA_MAX_SECONDS=900
VLA_MAX_RSS_MB=16384
# Recent primary record window; terminal overflow is logically archived, never deleted.
VLA_MAX_JOBS=20
# Finite total retained records, including logical archives and evaluations.
VLA_MAX_RECORDS=200
# Evaluation records are separate: 3 attempts per primary slot, at most 3 per checkpoint.
VLA_MAX_EVALUATIONS=60
VLA_TOTAL_MB=4096
# Select a backend only after its real rendering probe passes.
# MUJOCO_GL=osmesa
# PYOPENGL_PLATFORM=osmesa
